{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openmail",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "SEND_RATE_LIMITER", "class_name": "SendRateLimiter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SendRateLimiter"] }],
  "triggers": { "crons": ["* * * * *"] },
  "queues": {
    "producers": [{ "binding": "SEND_QUEUE", "queue": "openmail-send" }],
    "consumers": [
      { "queue": "openmail-send", "max_batch_size": 1, "max_retries": 5, "dead_letter_queue": "openmail-send-dlq" },
      { "queue": "openmail-send-dlq", "max_batch_size": 10 }
    ]
  },
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "7fb05fcba4b743a6bca47824beafefc5" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openmail",
      "database_id": "1dea8083-556e-46a2-9a16-59a877f8a9f7",
      "migrations_dir": "drizzle"
    }
  ]
}
