{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openmail",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "routes": [{ "pattern": "mail.mattwalker.co", "custom_domain": true }],
  "durable_objects": {
    "bindings": [{ "name": "SEND_RATE_LIMITER", "class_name": "SendRateLimiter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SendRateLimiter"] }],
  "triggers": { "crons": ["* * * * *"] },
  "queues": {
    "producers": [{ "binding": "SEND_QUEUE", "queue": "openmail-send" }],
    "consumers": [
      { "queue": "openmail-send", "max_batch_size": 1, "max_retries": 5, "dead_letter_queue": "openmail-send-dlq" },
      { "queue": "openmail-send-dlq", "max_batch_size": 10 }
    ]
  },
  "ratelimits": [{ "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "7fb05fcba4b743a6bca47824beafefc5" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openmail",
      "database_id": "1dea8083-556e-46a2-9a16-59a877f8a9f7",
      "migrations_dir": "drizzle"
    }
  ],
  // Cloudflare Worker Previews, one per branch. Every stateful binding points at preview-only
  // resources, so a Preview can never read production data or send email: queue consumers and cron
  // don't run in Previews, the Preview queue has no consumer, and Previews get no SES credentials.
  // The Durable Object binding is redeclared so each Preview gets its own namespace.
  "previews": {
    "vars": { "OPENMAIL_PREVIEW": "1" },
    "durable_objects": {
      "bindings": [{ "name": "SEND_RATE_LIMITER", "class_name": "SendRateLimiter" }]
    },
    "ratelimits": [{ "name": "AUTH_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }],
    "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "5584c11a8e6144f5a7ca5e4f1eaca47b" }],
    "queues": { "producers": [{ "binding": "SEND_QUEUE", "queue": "openmail-send-preview" }] },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "openmail-preview",
        "database_id": "29afb394-1d8f-44d1-97bd-a2b6c47addaf",
        "migrations_dir": "drizzle"
      }
    ]
  }
}
